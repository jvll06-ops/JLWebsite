{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "object",
      "properties": {
        "first": {
          "type": "string",
          "minLength": 1
        },
        "last": {
          "type": "string",
          "minLength": 1
        },
        "full": {
          "type": "string",
          "minLength": 1
        },
        "preferred": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "first",
        "last",
        "full"
      ],
      "additionalProperties": false
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "eventGroup": {
      "type": "string",
      "enum": [
        "sprints",
        "hurdles",
        "jumps",
        "throws",
        "distance",
        "multis",
        "other"
      ]
    },
    "events": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hometown": {
      "type": "string",
      "minLength": 1
    },
    "school": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "major": {
          "type": "string",
          "minLength": 1
        },
        "minor": {
          "type": "string",
          "minLength": 1
        },
        "classYear": {
          "type": "string",
          "minLength": 1
        },
        "gradDate": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "website": {
          "type": "string",
          "format": "uri"
        },
        "linkedin": {
          "type": "string",
          "minLength": 1
        },
        "instagram": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "string",
          "minLength": 1
        },
        "tiktok": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "bio": {
      "type": "object",
      "properties": {
        "short": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "long": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "stats": {
      "default": [],
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "prs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "mark": {
            "type": "string",
            "minLength": 1
          },
          "wind": {
            "type": "string",
            "minLength": 1
          },
          "meet": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "number"
              }
            ]
          },
          "indoor": {
            "type": "boolean"
          }
        },
        "required": [
          "event",
          "mark"
        ],
        "additionalProperties": false
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "year": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "number"
              }
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "year",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "honors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "number"
              }
            ]
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    },
    "inTheirWords": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "number"
              }
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "press": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "outlet": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "number"
              }
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "strengths": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    },
    "resume": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "experience": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "org": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "string",
                "minLength": 1
              },
              "dates": {
                "type": "string",
                "minLength": 1
              },
              "bullets": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "role"
            ],
            "additionalProperties": false
          }
        },
        "education": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "school": {
                "type": "string",
                "minLength": 1
              },
              "degree": {
                "type": "string",
                "minLength": 1
              },
              "dates": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "school"
            ],
            "additionalProperties": false
          }
        },
        "athletics": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "org": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "string",
                "minLength": 1
              },
              "dates": {
                "type": "string",
                "minLength": 1
              },
              "bullets": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "role"
            ],
            "additionalProperties": false
          }
        },
        "leadership": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "org": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "string",
                "minLength": 1
              },
              "dates": {
                "type": "string",
                "minLength": 1
              },
              "bullets": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "role"
            ],
            "additionalProperties": false
          }
        },
        "skills": {
          "type": "object",
          "properties": {
            "core": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "tools": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "languages": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "honors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "year": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "hamzaQuote": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "default": "Hamza Deyaf, Founder & CEO, Feniex Industries",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "images": {
      "type": "object",
      "properties": {
        "hero": {
          "type": "string",
          "minLength": 1
        },
        "portrait": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "actionAlt": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "og": {
          "type": "string",
          "minLength": 1
        },
        "resumeCrop": {
          "type": "object",
          "properties": {
            "x": {
              "default": 0.5,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "default": 0.5,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "zoom": {
              "default": 1,
              "type": "number",
              "minimum": 1,
              "maximum": 2
            }
          },
          "additionalProperties": false
        },
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "featureFocus": {
          "type": "object",
          "properties": {
            "x": {
              "default": 0.5,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "default": 0.4,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "imagery": {
      "default": "ai",
      "type": "string",
      "enum": [
        "ai",
        "original"
      ]
    },
    "photoCredits": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "site": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "seo": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 70
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 170
        }
      },
      "additionalProperties": false
    },
    "noindex": {
      "type": "boolean"
    }
  },
  "required": [
    "slug",
    "name"
  ],
  "additionalProperties": false,
  "title": "Personal site: src/content/profile.json"
}
