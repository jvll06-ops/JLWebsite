---
// The handful of line icons the pages use (decorative; 1.5px strokes).
interface Props {
  name: 'arrow-right' | 'arrow-down' | 'arrow-up-right' | 'download' | 'mail';
  class?: string;
}
const { name, class: className } = Astro.props;
const paths: Record<Props['name'], string> = {
  'arrow-right': 'M4 12h15M13 6l6 6-6 6',
  'arrow-down': 'M12 4v15M6 13l6 6 6-6',
  'arrow-up-right': 'M7 17L17 7M8 7h9v9',
  download: 'M12 4v11M7 10l5 5 5-5M5 20h14',
  mail: 'M3.5 6.5h17v11h-17zM3.5 7l8.5 6.5L20.5 7',
};
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"><path d={paths[name]}></path></svg>
