---
// The signature moment, shot in a bright studio: the pro portrait in a tall,
// borderless panel on the right (its light-grey seamless is the panel), the
// name set huge in charcoal condensed Archivo on the white page beside it.
// Phones: the portrait first, edge to edge, the name below it.
// imagery "original": the untouched official photo as a framed print instead,
// credited, with no AI caption.
import type { SiteData } from '../lib/athlete.ts';
import { widthEm, resumeFileName, portraitCredit, PORTRAIT_NOTE } from './fit.ts';
import Photo from './Photo.astro';
import EmailLink from './EmailLink.astro';
import Icon from './Icon.astro';

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
const { a, site } = data;
const hero = data.images.hero;
const framed = a.imagery === 'original' && !hero.placeholder;
const note = hero.placeholder ? undefined : framed ? portraitCredit(a) : PORTRAIT_NOTE;
// The name's widest line, in em: the CSS divides the column width by it.
const nameWidth = Math.max(widthEm(a.name.first), widthEm(a.name.last)).toFixed(3);
// The eyebrow in two parts, program and discipline ("Texas Track & Field" + "200m · 100m · 4x100m"):
// where the line is too short for both, it breaks between them and nowhere else.
const [program, ...rest] = (a.headline ?? '').split('·').map((s) => s.trim()).filter(Boolean);
const discipline = rest.join(' · ');
---

<section
  class:list={['hero', { 'hero--framed': framed, 'hero--empty': hero.placeholder }]}
  aria-labelledby="hero-name"
  style={`--name-w: ${nameWidth}`}
>
  <div class="hero__media">
    {
      /* No portrait yet: a quiet studio panel with the initials. */
      hero.placeholder && (
        <div class="hero__panel hero__panel--empty" aria-hidden="true">
          <span>{data.initials}</span>
        </div>
      )
    }
    {
      !hero.placeholder && !framed && (
        <div class="hero__panel">
          <Photo
            class="hero__img"
            src={hero.src}
            alt={`Portrait of ${a.name.full}`}
            widths={[480, 640, 750, 960, 1280, 1536]}
            sizes="(min-width: 64rem) min(46vw, 45rem), (min-width: 48rem) 58vw, 100vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          {note && <p class="hero__note">{note}</p>}
        </div>
      )
    }
    {
      framed && (
        <figure class="hero__print">
          <div class="hero__frame">
            <Photo
              class="hero__photo"
              src={hero.src}
              alt={`Portrait of ${a.name.full}`}
              widths={[400, 560, 720, 1000]}
              sizes="(min-width: 64rem) min(32vw, 28rem), (min-width: 40rem) 24rem, 92vw"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              quality={60}
            />
          </div>
          {note && <figcaption class="hero__credit">{note}</figcaption>}
        </figure>
      )
    }
  </div>

  <div class="hero__body container">
    <div class="hero__copy">
      {
        program && (
          <p class="eyebrow hero__eyebrow">
            <span class="hero__eyebrow-parts">
              <span>{program}</span>
              {discipline && <span>{discipline}</span>}
            </span>
          </p>
        )
      }
      <h1 id="hero-name" class="hero__name display">
        <span class="hero__line"><span>{a.name.first}</span></span>
        <span class="hero__line"><span>{a.name.last}</span></span>
      </h1>
      {a.tagline && <p class="hero__tagline">{a.tagline}</p>}
      <div class="hero__actions">
        <a class="btn btn--primary" href="/resume/">
          View Resume <Icon name="arrow-right" class="btn__icon btn__icon--right" />
        </a>
        <a class="btn btn--outline" href="/resume.pdf" download={resumeFileName(a)}>
          Download PDF <Icon name="download" class="btn__icon btn__icon--down" />
        </a>
        <EmailLink data={data} class="btn btn--ghost hero__email">
          <Icon name="mail" class="btn__icon" />
          <span class="btn__label">Email {data.displayName}</span>
        </EmailLink>
      </div>
      <p class="hero__chip">
        <span class="hero__dot" aria-hidden="true"></span>
        <span>Project Manager Intern</span>
        <span class="hero__sep" aria-hidden="true">·</span>
        <span>{site.feniex.name}</span>
        <span class="hero__sep" aria-hidden="true">·</span>
        <span>2026</span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    --name-max: 6.75rem;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    padding-top: var(--header-h);
    padding-bottom: var(--space-8);
    background: var(--page);
  }

  /* ---------- The studio panel ---------- */
  .hero__media {
    position: relative;
  }
  .hero__panel {
    position: relative;
    height: min(122vw, 70svh);
    min-height: 22rem;
    overflow: hidden;
    background: var(--surface-2);
  }
  .hero :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 16%;
  }
  .hero__panel--empty {
    display: grid;
    place-items: center;
    height: min(70vw, 40svh);
    min-height: 14rem;
    font-family: var(--font-display);
    font-stretch: var(--stretch-condensed);
    font-weight: var(--weight-display);
    font-size: clamp(6rem, 20vw, 12rem);
    color: var(--line-strong);
  }
  /* The one caption, set like a print label on the photo's lower corner. */
  .hero__note {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    max-width: calc(100% - 2 * var(--space-3));
    padding: 0.3rem 0.6rem;
    border-radius: 2px;
    background: rgba(250, 250, 248, 0.88);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    font-size: var(--text-2xs);
    line-height: 1.35;
    letter-spacing: 0.01em;
    color: var(--text-muted);
  }

  /* ---------- Original photo: a framed print on the wall ---------- */
  .hero__print {
    width: min(100% - 2 * var(--gutter), 24rem);
    margin: var(--space-6) auto 0 var(--gutter);
  }
  .hero__frame {
    position: relative;
    isolation: isolate;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lift);
  }
  /* The offset keyline: one fine accent rule, down and to the right. */
  .hero__frame::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border: 1px solid var(--accent-line);
    border-radius: inherit;
    transform: translate(0.75rem, 0.75rem);
  }
  .hero__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgb(23 24 27 / 0.08);
    border-radius: inherit;
    pointer-events: none;
  }
  .hero :global(.hero__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
    border-radius: var(--radius-sm);
  }
  .hero__credit {
    margin-top: calc(var(--space-4) + 0.75rem);
    font-size: var(--text-2xs);
    letter-spacing: 0.01em;
    color: var(--text-muted);
  }

  /* ---------- Copy ---------- */
  .hero__body {
    position: relative;
    margin-top: var(--space-6);
  }
  .hero__copy {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  /* The rule sits on the first line; the two parts wrap as wholes. */
  .hero__eyebrow {
    --sep: 1.3em;
    align-items: flex-start;
    margin-bottom: var(--space-4);
  }
  .hero__eyebrow::before {
    margin-top: calc(0.65em - 0.5px);
  }
  /* The dot between the parts is drawn in the second part's left padding. Every
     line starts in the clipped strip, so a part that wraps to a new line loses
     its dot instead of starting (or ending) a line with it. */
  .hero__eyebrow-parts {
    display: flex;
    flex-wrap: wrap;
    margin-left: calc(-1 * var(--sep));
    clip-path: inset(0 0 0 var(--sep));
  }
  .hero__eyebrow-parts > span {
    position: relative;
    padding-left: var(--sep);
  }
  .hero__eyebrow-parts > span + span::before {
    content: '·';
    position: absolute;
    left: 0;
    width: var(--sep);
    text-align: center;
  }
  .hero__name {
    font-size: min(var(--name-max), calc(100cqi / (var(--name-w) * 1.04)));
    line-height: 0.86;
    color: var(--text);
  }
  .hero__line {
    display: block;
  }
  .hero__line > span {
    display: block;
    animation: name-in 1100ms var(--ease-out) both;
  }
  .hero__line + .hero__line > span {
    animation-delay: 110ms;
  }
  @keyframes name-in {
    from {
      opacity: 0;
      transform: translate3d(0, 0.3em, 0);
      filter: blur(8px);
    }
  }
  .hero__tagline {
    margin-top: var(--space-5);
    max-width: 30ch;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.375rem, 1rem + 1.4vw, 2rem);
    line-height: 1.25;
    text-wrap: balance;
    color: var(--text-soft);
    animation: fade-up 1000ms 250ms var(--ease-out) both;
  }
  .hero__actions {
    display: grid;
    width: 100%;
    gap: var(--space-3);
    margin-top: var(--space-6);
    animation: fade-up 1000ms 380ms var(--ease-out) both;
  }
  .hero__actions :global(.btn) {
    width: 100%;
  }
  .hero__chip {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.55rem;
    margin-top: var(--space-6);
    padding: 0.55rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
    line-height: 1.3;
    color: var(--text-soft);
    animation: fade-up 1000ms 480ms var(--ease-out) both;
  }
  /* Narrow columns (phones, and the tablet's half): the chip stays on one line. */
  @media (max-width: 26rem), (min-width: 48rem) and (max-width: 63.99rem) {
    .hero__chip {
      font-size: var(--text-2xs);
      letter-spacing: 0;
      padding-inline: 0.85rem;
    }
  }
  /* Phones: a shorter rule and a little less tracking, so the longest discipline
     ("Steeplechase & Cross Country") holds one line at 360px. */
  @media (max-width: 26rem) {
    .hero__eyebrow {
      gap: 0.7em;
      letter-spacing: 0.12em;
    }
    .hero__eyebrow::before {
      width: 1.25rem;
    }
  }
  .hero__dot {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .hero__sep {
    color: var(--line-strong);
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translate3d(0, 16px, 0);
    }
  }

  @media (min-width: 40rem) {
    .hero {
      --name-max: 9rem;
    }
    .hero__panel {
      height: min(88vw, 64svh);
    }
    .hero :global(.hero__img) {
      object-position: 50% 12%;
    }
    /* Tablets: the buttons sit in a row at their own width. */
    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      width: auto;
    }
    .hero__actions :global(.btn) {
      width: auto;
    }
  }

  /* ---------- Tablets: the same two columns as the desktop, at their own size ----------
     (A 3:4 portrait in a full-width band is all face on a tablet, and pushes the name off the first screen.) */
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .hero {
      --name-max: 7.5rem;
      --panel-w: 46vw;
      /* At least a true 3:4 panel under the header; taller when the copy needs it. */
      min-height: calc(var(--header-h) + var(--panel-w) * 4 / 3);
      justify-content: center;
      padding-bottom: var(--space-7);
    }
    .hero__media {
      position: absolute;
      top: var(--header-h);
      right: 0;
      bottom: 0;
      width: var(--panel-w);
    }
    .hero__panel {
      height: 100%;
      min-height: 0;
    }
    .hero :global(.hero__img) {
      object-position: 50% 0%;
    }
    .hero__body {
      margin-top: 0;
      padding-top: var(--space-7);
    }
    .hero__copy {
      width: calc(100vw - var(--panel-w) - var(--gutter) - var(--space-6));
    }
    /* The column is narrow: the buttons stack at its full width, as on a phone. */
    .hero__actions {
      display: grid;
      width: 100%;
    }
    .hero__actions :global(.btn) {
      width: 100%;
    }
    .hero--framed .hero__media {
      top: calc(var(--header-h) + (100% - var(--header-h)) / 2);
      right: var(--gutter);
      bottom: auto;
      width: 38vw;
      transform: translateY(-50%);
    }
    .hero__print {
      width: 100%;
      margin: 0;
    }
    .hero--framed .hero__copy {
      width: calc(100vw - 38vw - 2 * var(--gutter) - var(--space-7));
    }
  }

  /* ---------- Desktop: name left, the portrait panel right ---------- */
  @media (min-width: 64rem) {
    .hero {
      --name-max: 10.5rem;
      --hero-h: max(40rem, min(100svh, 60rem));
      /* A true 3:4 panel as tall as the hero below the header, never wider than 46% of the screen. */
      --panel-w: min(46vw, calc((var(--hero-h) - var(--header-h)) * 0.75));
      /* Where the container's left edge sits. */
      --edge: max(var(--gutter), calc((100vw - var(--container)) / 2));
      min-height: var(--hero-h);
      justify-content: center;
      padding-bottom: var(--space-7);
    }
    .hero__media {
      position: absolute;
      top: var(--header-h);
      right: 0;
      bottom: 0;
      width: var(--panel-w);
    }
    .hero__panel {
      height: 100%;
      min-height: 0;
    }
    .hero :global(.hero__img) {
      object-position: 50% 0%;
    }
    .hero__note {
      left: auto;
      right: var(--space-4);
      bottom: var(--space-4);
    }
    .hero__body {
      margin-top: 0;
      padding-top: var(--space-7);
    }
    .hero__copy {
      width: min(100%, 50rem, calc(100vw - var(--panel-w) - var(--edge) - clamp(3rem, 6vw, 6rem)));
    }
    .hero__actions {
      margin-top: var(--space-7);
    }
    .hero__chip {
      margin-top: var(--space-7);
    }

    /* The framed print: right edge on the container, centred in the hero below the header. */
    .hero--framed .hero__media {
      top: calc(var(--header-h) + (100% - var(--header-h)) / 2);
      right: var(--edge);
      bottom: auto;
      width: min(32vw, 28rem, calc((var(--hero-h) - var(--header-h) - 9rem) * 0.75));
      min-width: 17rem;
      transform: translateY(-50%);
    }
    .hero__print {
      width: 100%;
      margin: 0;
    }
    .hero__frame {
      aspect-ratio: 3 / 4;
    }
    .hero__frame::before {
      transform: translate(1rem, 1rem);
    }
    .hero--framed .hero__copy {
      width: min(100%, 46rem, calc(100vw - min(32vw, 28rem) - 2 * var(--edge) - 6rem));
    }
  }
</style>
