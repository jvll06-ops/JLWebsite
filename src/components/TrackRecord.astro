---
// Track Record on a light grey band: a white card with the PR table, then
// the timeline (accent nodes) and the honors as chips. Each part hides when
// its data is empty.
import type { SiteData } from '../lib/athlete.ts';
import { splitMark } from './fit.ts';

interface Props {
  data: SiteData;
}
const { a } = Astro.props.data;
const { prs, timeline, honors } = a;
const hasAny = prs.length + timeline.length + honors.length > 0;
const events = a.events.join(' · ');
---

{
  hasAny && (
    <section id="track-record" class="section section--surface track" aria-labelledby="track-title">
      <div class="container track__inner">
        <header class="section__head" data-reveal>
          <span class="eyebrow">Track record</span>
          <h2 id="track-title" class="section__title">
            The record
          </h2>
          {events && <p class="section__lede">{events}</p>}
        </header>

        {prs.length > 0 && (
          <div id="personal-records" class="track__card" data-reveal>
            <h3 class="track__subtitle">Personal records</h3>
            <table class="track__table" role="table">
              <thead class="track__thead" role="rowgroup">
                <tr role="row">
                  <th scope="col" role="columnheader">Event</th>
                  <th scope="col" role="columnheader">Mark</th>
                  <th scope="col" role="columnheader">Meet</th>
                  <th scope="col" role="columnheader" class="track__col-year">Year</th>
                </tr>
              </thead>
              <tbody role="rowgroup">
                {prs.map((pr) => {
                  const mark = splitMark(pr.mark);
                  return (
                    <tr role="row">
                      <th scope="row" role="rowheader" class="track__event">
                        <span>{pr.event}</span>
                        {pr.indoor !== undefined && (
                          <span class="track__tag">{pr.indoor ? 'Indoor' : 'Outdoor'}</span>
                        )}
                      </th>
                      <td role="cell" class="track__mark">
                        <span class="track__mark-main">{mark.main}</span>
                        {mark.aside && <span class="track__mark-aside">{mark.aside}</span>}
                        {pr.wind && <span class="track__mark-aside">wind {pr.wind}</span>}
                      </td>
                      <td
                        role="cell"
                        class="track__meet"
                        data-year={pr.year ? (pr.meet ? `\u00a0·\u00a0${pr.year}` : pr.year) : undefined}
                      >
                        {pr.meet ?? ''}
                      </td>
                      <td role="cell" class="track__year-cell">{pr.year ?? ''}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}

        {(timeline.length > 0 || honors.length > 0) && (
          <div class="track__cols" data-single={timeline.length === 0 || honors.length === 0 ? '' : undefined}>
            {timeline.length > 0 && (
              <div class="track__block" data-reveal>
                <h3 class="track__subtitle">Timeline</h3>
                <ol class="track__timeline">
                  {timeline.map((t) => (
                    <li class="track__step">
                      <span class="track__node" aria-hidden="true" />
                      <p class="track__year">{t.year}</p>
                      <p class="track__step-title">{t.title}</p>
                      {t.detail && <p class="track__detail">{t.detail}</p>}
                    </li>
                  ))}
                </ol>
              </div>
            )}
            {honors.length > 0 && (
              <div class="track__block" data-reveal>
                <h3 class="track__subtitle">Honors</h3>
                <ul id="athletic-honors" class="track__honors">
                  {honors.map((h) => (
                    <li class="track__honor">
                      <span>{h.title}</span>
                      {h.year && <span class="track__honor-year">{h.year}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .track__inner {
    position: relative;
  }

  .track__subtitle {
    margin-bottom: var(--space-5);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ---------- The record card + PR table ---------- */
  .track__card {
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--card);
    box-shadow: var(--shadow-card);
  }
  .track__table {
    width: 100%;
    border-collapse: collapse;
  }
  .track__thead {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .track__table tbody,
  .track__table tr {
    display: block;
  }
  .track__table tbody tr {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .track__table tbody tr:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .track__table th,
  .track__table td {
    padding: 0;
    text-align: left;
    font-weight: inherit;
  }
  .track__event {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }
  .track__tag {
    display: inline-block;
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .track__mark {
    grid-row: span 2;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }
  .track__mark-main {
    font-family: var(--font-display);
    font-stretch: var(--stretch-condensed);
    font-weight: var(--weight-display);
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--text);
  }
  .track__mark-aside {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--text-muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .track__meet,
  .track__year-cell {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .track__meet {
    grid-column: 1;
  }
  .track__year-cell {
    display: none;
  }
  /* Phones: the year follows the meet, glued to its last word (no-break spaces
     in data-year), so no line starts or ends with "·" and no year sits alone. */
  @media (max-width: 47.99rem) {
    .track__meet[data-year]::after {
      content: attr(data-year);
    }
  }

  /* ---------- Timeline + honors ---------- */
  .track__cols {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-8);
  }
  .track__timeline,
  .track__honors {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .track__timeline {
    position: relative;
    padding-left: var(--space-6);
  }
  .track__timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: linear-gradient(180deg, var(--accent), var(--line-strong) 30%, var(--line-strong) 85%, transparent);
  }
  .track__step {
    position: relative;
    padding-bottom: var(--space-6);
  }
  .track__step:last-child {
    padding-bottom: 0;
  }
  .track__node {
    position: absolute;
    left: calc(-1 * var(--space-6));
    top: 0.3rem;
    width: 11px;
    height: 11px;
    border: 1.5px solid var(--accent);
    border-radius: 50%;
    background: var(--surface);
    box-shadow: 0 0 0 4px var(--surface);
  }
  .track__year {
    font-family: var(--font-display);
    font-stretch: var(--stretch-condensed);
    font-weight: var(--weight-display);
    font-size: var(--text-lg);
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .track__step-title {
    margin-top: var(--space-1);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: 1.3;
  }
  .track__detail {
    margin-top: var(--space-1);
    max-width: 36rem;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--text-muted);
  }
  .track__honors {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .track__honor {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    background: var(--card);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: 1.4;
    transition: border-color var(--duration) var(--ease);
  }
  .track__honor:hover {
    border-color: var(--accent-line);
  }
  .track__honor > span:first-child {
    text-wrap: balance;
  }
  .track__honor-year {
    flex: none;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Wider: a real four-column table ---------- */
  @media (min-width: 48rem) {
    .track__card {
      padding: var(--space-6) var(--space-7) var(--space-5);
    }
    .track__thead {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      display: table-header-group;
    }
    .track__table tbody {
      display: table-row-group;
    }
    .track__table tr,
    .track__table tbody tr {
      display: table-row;
    }
    .track__table th,
    .track__table td {
      display: table-cell;
      padding: var(--space-4) var(--space-5) var(--space-4) 0;
      border-top: 1px solid var(--line);
      vertical-align: middle;
    }
    .track__table thead th {
      padding-top: 0;
      border-top: 0;
      font-size: var(--text-2xs);
      font-weight: var(--weight-semibold);
      letter-spacing: var(--tracking-caps);
      text-transform: uppercase;
      color: var(--text-muted);
    }
    .track__table thead th:nth-child(2) {
      padding-right: var(--space-7);
      text-align: right;
    }
    .track__event {
      display: table-cell;
    }
    .track__event .track__tag {
      margin-left: var(--space-2);
    }
    .track__table .track__mark {
      display: table-cell;
      width: 1%;
      padding-right: var(--space-7);
      text-align: right;
      white-space: nowrap;
    }
    .track__table .track__event {
      width: 34%;
    }
    .track__mark-aside {
      display: block;
    }
    .track__table .track__year-cell,
    .track__table .track__col-year {
      display: table-cell;
      width: 1%;
      padding-right: 0;
      text-align: right;
      font-variant-numeric: tabular-nums;
    }
  }

  @media (min-width: 64rem) {
    .track__cols {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-9);
      margin-top: var(--space-9);
    }
    .track__cols[data-single] {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    }
    .track__cols > .track__block:nth-child(2) {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }
  }
</style>
